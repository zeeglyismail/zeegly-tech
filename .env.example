# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
#
# Only needed if you run the bundled cloudflared service:
#   docker compose --profile tunnel up -d
#
# Get the token from: Cloudflare Zero Trust -> Networks -> Tunnels
#   -> zeegly1 -> Configure -> copy the token from the install command.
TUNNEL_TOKEN=
